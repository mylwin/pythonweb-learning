# 后端接口地址。
# 开发环境留空即可：请求会走 vite.config.js 里的 /api 代理。
# 部署到独立域名时再填完整地址，例如 https://api.example.com
VITE_API_BASE_URL=

# 开发环境 vite 代理的后端地址
VITE_PROXY_TARGET=http://127.0.0.1:8000

# AI 问答配置：仅用于本地联调，正式环境必须改为后端代理，
# 不要把真实 Key 写进仓库或提交到 git。
VITE_AI_API_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
VITE_AI_API_KEY=
VITE_AI_MODEL=qwen3-max-preview
